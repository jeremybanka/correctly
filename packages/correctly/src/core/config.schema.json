{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"additionalProperties": false,
	"required": ["associations"],
	"properties": {
		"$schema": { "type": "string" },
		"files": { "$ref": "#/definitions/patterns" },
		"exclude": { "$ref": "#/definitions/patterns" },
		"associations": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["files", "schema"],
				"properties": {
					"name": { "type": "string", "minLength": 1 },
					"files": { "$ref": "#/definitions/patterns" },
					"schema": { "type": ["string", "null"], "minLength": 1 },
					"mode": { "enum": ["json", "jsonc"] },
					"extensions": {
						"description": "Exact extension IDs enabled for this schema and its references.",
						"type": "array",
						"uniqueItems": true,
						"items": { "type": "string", "minLength": 1 }
					}
				},
				"allOf": [
					{
						"if": { "properties": { "schema": { "type": "null" } } },
						"then": {
							"properties": { "extensions": { "type": "array", "maxItems": 0 } }
						}
					}
				]
			}
		},
		"remote": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"offline": { "type": "boolean" },
				"cacheDir": { "type": "string", "minLength": 1 },
				"timeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
				"maxBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
				"maxRequests": { "type": "integer", "minimum": 1, "maximum": 256 }
			}
		}
	},
	"definitions": {
		"patterns": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"minLength": 1,
				"pattern": "^(?![/!])(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
			}
		}
	}
}
