{
	"name": "correctly-vscode",
	"displayName": "Correctly",
	"version": "0.0.0",
	"private": true,
	"description": "JSON Schema and Pkl validation from one external configuration",
	"categories": [
		"Linters",
		"Programming Languages"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/correctly.git",
		"directory": "packages/correctly/src/vscode"
	},
	"license": "MPL-2.0",
	"publisher": "jeremybanka",
	"type": "module",
	"main": "./dist/extension.mjs",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"contributes": {
		"languages": [
			{ "id": "pkl", "aliases": ["Pkl", "pkl"], "extensions": [".pkl"] }
		],
		"commands": [
			{
				"command": "correctly.restartServer",
				"title": "Correctly: Restart Server"
			}
		]
	},
	"activationEvents": [
		"onLanguage:json",
		"onLanguage:jsonc",
		"onLanguage:yaml",
		"onLanguage:toml",
		"workspaceContains:**/correctly.config.ts",
		"onLanguage:pkl"
	],
	"engines": {
		"vscode": "^1.105.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Correctly evaluates the project TypeScript configuration and its imported parser, validator, and extension code."
		}
	},
	"extensionKind": [
		"workspace"
	]
}
