{
	"name": "correctly-workspace",
	"private": true,
	"license": "MPL-2.0",
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"build:vsix": "pnpm --filter correctly build:vsix",
		"check": "pnpm run \"/^check:.*/\"",
		"check:fmt": "dprint check",
		"check:vp": "vp check --no-fmt",
		"fmt": "dprint fmt",
		"test": "vp run -r test",
		"test:watch": "vp run -r --parallel --no-cache test:watch",
		"change": "changeset",
		"release:publish": "pnpm build && changeset publish",
		"release:version": "changeset version",
		"check:tests": "node scripts/check-test-workloads.ts",
		"check:correctly": "node packages/correctly/src/cli/main.ts check",
		"test:distribution": "vp run -r test:distribution",
		"test:schemars": "node scripts/check-schemars.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.26.0",
		"@dprint/oxc": "0.44.0",
		"@dprint/toml": "0.9.0",
		"correctly": "workspace:*",
		"dprint": "0.60.1",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.0.2",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "26.10.0",
		"pnpm": "12.9.1"
	}
}
