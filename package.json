{
	"name": "correctly-workspace",
	"private": true,
	"license": "MPL-2.0",
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"build:vsix": "pnpm -r build:vsix",
		"build:zed": "pnpm --filter correctly build:zed",
		"check": "pnpm run \"/^check:.*/\"",
		"check:fmt": "dprint check && cargo fmt --manifest-path packages/correctly/src/zed/Cargo.toml -- --check",
		"check:vp": "vp check --no-fmt",
		"fmt": "dprint fmt && cargo fmt --manifest-path packages/correctly/src/zed/Cargo.toml",
		"test": "vp run -r test",
		"test:watch": "vp run -r --parallel --no-cache test:watch",
		"change": "changeset",
		"release:publish": "pnpm build && changeset publish",
		"release:version": "changeset version",
		"check:tests": "node scripts/check-test-workloads.ts",
		"check:correctly": "node packages/correctly/src/cli/main.ts check",
		"test:distribution": "vp run -r test:distribution",
		"test:schemars": "node scripts/check-schemars.ts",
		"test:public": "pnpm -r test:public",
		"test:breakage": "pnpm -r test:breakage",
		"test:peers": "pnpm --filter @correctlyjs/schemars test:peers",
		"prepare:peers": "pnpm build && pnpm -C packages/correctly pack --out ../../artifacts/correctly.tgz && pnpm -C packages/schemars pack --out ../../artifacts/schemars.tgz"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.28.2",
		"@dprint/oxc": "0.48.0",
		"@dprint/toml": "0.9.0",
		"correctly": "workspace:*",
		"dprint": "0.64.3",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.0.2",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "26.12.1",
		"pnpm": "12.16.1"
	}
}
