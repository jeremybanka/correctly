{
	"name": "correctly-workspace",
	"private": true,
	"license": "MPL-2.0",
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"build:vsix": "pnpm --filter correctly build:vsix",
		"check": "pnpm run \"/^check:.*/\"",
		"check:fmt": "dprint check",
		"check:vp": "vp check --no-fmt",
		"fmt": "dprint fmt",
		"test": "vp run -r test",
		"test:watch": "vp run -r --parallel --no-cache test:watch",
		"change": "changeset",
		"release:version": "changeset version",
		"check:correctly": "node packages/correctly/src/cli/main.ts check",
		"test:distribution": "pnpm --filter correctly exec vp test tests/private/distribution.test.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.25.0",
		"@dprint/markdown": "0.24.0",
		"@dprint/oxc": "0.42.0",
		"@dprint/toml": "0.8.0",
		"dprint": "0.58.0",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.0.2",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": "26.10.0",
		"pnpm": "12.8.1"
	}
}
