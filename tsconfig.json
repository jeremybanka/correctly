{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"erasableSyntaxOnly": true,
		"exactOptionalPropertyTypes": true,
		"lib": [
			"ES2024"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"rootDir": ".",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024",
		"types": [],
		"paths": {
			"correctly": [
				"./packages/correctly/src/core/index.ts"
			],
			"correctly/validators/ajv": [
				"./packages/correctly/src/validators/ajv.ts"
			],
			"@correctlyjs/schemars": [
				"./packages/schemars/src/index.ts"
			],
			"correctly/extensions/renovate": [
				"./packages/correctly/src/extensions/renovate.ts"
			]
		}
	},
	"include": [
		"**/*.ts",
		"*.d.ts"
	]
}
